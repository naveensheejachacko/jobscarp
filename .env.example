# --- Database ---
DATABASE_URL=postgresql+psycopg://jobauto:jobauto@db:5432/jobauto

# --- Gmail API (OAuth installed-app flow) ---
# Download credentials.json from Google Cloud Console (OAuth client ID, type "Desktop app").
# token.json is generated automatically on first run after you complete the browser consent.
GMAIL_CREDENTIALS_PATH=./credentials.json
GMAIL_TOKEN_PATH=./token.json

# Gmail search queries per source — edit freely, no code changes needed.
GMAIL_QUERY_CUTSHORT=from:(cutshort.io)
GMAIL_QUERY_INSTAHYRE=from:(instahyre.com)

# --- Google Sheets ---
# Spreadsheet ID from its URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=

# --- LLM provider (abstracted — switch providers with one line) ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Notifications ---
NOTIFY_MIN_SCORE=90
NOTIFY_EMAIL_TO=you@example.com

# --- Scheduler ---
PROCESS_INTERVAL_MINUTES=30

# --- Misc ---
LOG_LEVEL=INFO
PROFILE_PATH=./profile.yaml
